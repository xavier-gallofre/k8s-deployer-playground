# =============================================================================
# Configuración del Playground
# =============================================================================
# Copia este archivo a .env y modifica los valores según tus necesidades
# cp .env.example .env

# Nombre del profile de Minikube (para no conflictar con otros clústers)
PLAYGROUND_PROFILE=k8s-playground

# Recursos del clúster
MINIKUBE_CPUS=4
MINIKUBE_MEMORY=8192
MINIKUBE_DISK_SIZE=20g
MINIKUBE_DRIVER=docker

# Versión de Kubernetes (stable, latest, o versión específica como v1.35.1)
MINIKUBE_K8S_VERSION=stable

# =============================================================================
# Opciones avanzadas
# =============================================================================

# Addons a instalar (separados por espacio)
# Opciones disponibles: ingress, traefik, dashboard, metrics-server, etc.
# MINIKUBE_ADDONS="ingress traefik"

# Namespace para aplicaciones de ejemplo
# APP_NAMESPACE=demo

# Versiones de componentes (descomentar para fijar versiones específicas)
# HELM_VERSION=3.21.4
# ISTIO_VERSION=1.30.0
# ARGO_CD_VERSION=v3.5.1
# ARGO_ROLLOUTS_VERSION=v1.9.1
